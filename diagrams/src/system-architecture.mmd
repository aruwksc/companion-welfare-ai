    style UI fill:#ffffff,stroke:#333333,stroke-width:1.5px;
    style Core fill:#ffffff,stroke:#333333,stroke-width:1.5px;
    style Worker fill:#ffffff,stroke:#333333,stroke-width:1.5px;
