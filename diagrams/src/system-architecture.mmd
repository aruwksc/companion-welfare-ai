    classDef storage fill:#eeeeee,stroke:#222222,color:#111111,stroke-width:1.5px;
    class Owner,Video,Screens,API,Services,Repo,Sampler,Pose,Tracker,Features,Classifier component;
    class ModelPkg,DB,VideoStore storage;
